# ============================================================================
# Шаблон файла .env — хранилище чувствительных данных.
#
# Как пользоваться:
#   1. Скопируйте этот файл и переименуйте в .env
#      Windows:      copy .env.example .env
#      Linux/macOS:  cp .env.example .env
#   2. Заполните нужные переменные
#   3. Файл .env НИКОГДА не коммитится (добавлен в .gitignore)
#      и не попадает в Docker-образ (.dockerignore)
#
# Приоритет источников (от высшего к низшему):
#   переменные окружения (docker run -e, export в shell)  ->  .env  ->  config.toml
#
# Пустая или незаданная переменная = значение берётся из config.toml.
# ============================================================================

# --- Telegram ---------------------------------------------------------------
# Токен бота от @BotFather. НЕ публикуйте его: бот может быть угнан.
#TG_TOKEN=1234567890:AAHh...source...

# Список chat_id получателей уведомлений (через запятую).
# Свой chat_id можно узнать у @userinfobot
#TG_CHAT_ID=123456789,987654321

# --- VK ----------------------------------------------------------------------
# Токен сообщества ВКонтакте с правом на отправку сообщений (docs/NOTIFICATIONS.md)
#VK_TOKEN=abcdef1234567890abcdef1234567890abcdef123...

# Список id пользователей, которым отправлять сообщения ВКонтакте.
# Можно указывать VK_ID или VK_USER_ID — это одно и то же.
# Это числовой id (например 1234567), а не имя аккаунта.
#VK_ID=1234567,7654321

# --- Собственный сервис обхода блокировок (spfa) ------------------------------
# API-ключ сервиса cookies
#COOKIES_API_KEY=your_cookies_api_key

# --- Прокси -------------------------------------------------------------------
# Формат: login:pass@host:port  (или host:port без авторизации)
#PROXY_STRING=login:password@192.168.0.1:8000

# Ссылка на смену IP мобильного прокси (например mobileproxy.rent)
#PROXY_CHANGE_URL=https://mobileproxy.rent/api/change_ip?...

# Прокси отдельным адресом для рассылки Telegram (необязательно)
#PROXY_NOTIFIER=http://login:password@host:port
